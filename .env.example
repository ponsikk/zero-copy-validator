# ============================================
# Zero-Copy JSON Validator Configuration
# ============================================
# Copy this file to .env and adjust values for your needs

# ============================================
# Validation Limits
# ============================================

# Maximum JSON size in bytes (default: 500MB)
# For larger files use streaming mode
MAX_JSON_SIZE=524288000

# Maximum JSON nesting depth (protection against malicious deeply nested JSON)
# Default: 128 levels
MAX_JSON_DEPTH=128

# Maximum string length in JSON (protection against DoS)
# Default: 10MB
MAX_STRING_LENGTH=10485760

# ============================================
# Performance Settings
# ============================================

# Enable SIMD optimizations (true/false)
# Default: true (recommended for performance)
ENABLE_SIMD=true

# Thread pool size for batch validation
# Default: number of CPU cores
# Set to 0 for auto-detection
THREAD_POOL_SIZE=0

# ============================================
# Streaming Settings
# ============================================

# Chunk size for streaming validation (bytes)
# Default: 64MB
STREAM_CHUNK_SIZE=67108864

# ============================================
# Development/Debug
# ============================================

# Enable verbose logging (true/false)
# Default: false
VERBOSE_LOGGING=false

# Enable performance metrics collection
# Default: false
COLLECT_METRICS=false
